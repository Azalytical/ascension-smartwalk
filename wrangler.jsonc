// Cloudflare Workers deployment of the same bundle: npm run build && npx wrangler deploy
// Secret: npx wrangler secret put GEMINI_API_KEY
{
  "name": "ascension-smartwalk",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Without D1 or a rate limiter binding, the in-isolate budget (8/min per address, 500/day) gates generation.
  // Free tier: gemini-3.8-flash allows 20 requests a day, gemini-3.5-flash-lite 500 a day and 15 a minute.
  "vars": { "MEMORY_BUDGET": "1", "GEMINI_MODEL": "gemini-3.5-flash-lite", "WEATHER": "1" },
  // Run next to Google: from Cloudflare's Astana location the Gemini API is unreachable and every answer falls back.
  "placement": { "region": "gcp:europe-west1" },
  // Friends, location sharing, meetups and events: one SQLite-backed Durable Object per city (available on the Workers Free plan).
  // Watch reminders ("time to head back" via Web Push): VAPID keys and pending reminders, woken by an alarm.
  "durable_objects": { "bindings": [{ "name": "SOCIAL", "class_name": "SocialHub" }, { "name": "WATCH_PUSH", "class_name": "WatchPush" }] },
  "migrations": [{ "tag": "social-v1", "new_sqlite_classes": ["SocialHub"] }, { "tag": "watch-v1", "new_sqlite_classes": ["WatchPush"] }]
}
